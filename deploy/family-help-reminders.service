[Unit]
Description=Family HelpDesk reminder runner
After=network.target postgresql.service

[Service]
Type=oneshot
User=your-username
WorkingDirectory=/data/apps/familyHelp
EnvironmentFile=/data/apps/familyHelp/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /data/apps/familyHelp/scripts/send-reminders.js
